import java.util.Scanner;

public class DelimiterCheckerTrace {

    // ---------- Simple array-based stack of characters ----------
    static class CharStack {
        private char[] data = new char[10];
        private int size = 0;

        void push(char c) {
            if (size == data.length) {
                char[] bigger = new char[data.length * 2];
                System.arraycopy(data, 0, bigger, 0, size);
                data = bigger;
            }
            data[size++] = c;
        }

        char pop()  { return data[--size]; }
        char peek() { return data[size - 1]; }
        boolean isEmpty() { return size == 0; }

        // Stack contents from bottom to top, e.g. "{ [ ("
        String show() {
            if (size == 0) return "(empty)";
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < size; i++) {
                if (i > 0) sb.append(' ');
                sb.append(data[i]);
            }
            return sb.toString();
        }
    }

    static char opener(char close) {
        if (close == ')') return '(';
        if (close == ']') return '[';
        return '{';
    }

    static boolean isOpening(char c) { return c == '(' || c == '[' || c == '{'; }
    static boolean isClosing(char c) { return c == ')' || c == ']' || c == '}'; }

    static String check(String input) {
        CharStack stack = new CharStack();

        for (int i = 0; i < input.length(); i++) {
            char c = input.charAt(i);

            if (isOpening(c)) {
                System.out.println("Read: " + c);
                stack.push(c);
                System.out.println("Operation: PUSH " + c);
                System.out.println("Stack: " + stack.show());
                System.out.println();
            } else if (isClosing(c)) {
                System.out.println("Read: " + c);
                if (stack.isEmpty()) {
                    System.out.println("Operation: CHECK EMPTY -> stack is empty");
                    System.out.println("Stack: " + stack.show());
                    return "Invalid - closing delimiter '" + c
                         + "' at position " + (i + 1) + " has no matching opening delimiter";
                }
                char top = stack.peek();
                System.out.println("Operation: PEEK -> " + top);
                if (top == opener(c)) {
                    stack.pop();
                    System.out.println("Operation: POP " + top + " (matches " + c + ")");
                    System.out.println("Stack: " + stack.show());
                    System.out.println();
                } else {
                    System.out.println("Stack: " + stack.show());
                    return "Invalid - mismatched delimiters: '" + c
                         + "' at position " + (i + 1) + " does not match '" + top + "'";
                }
            }
        }

        if (!stack.isEmpty()) {
            System.out.println("End of input. Stack: " + stack.show());
            return "Invalid - unmatched opening delimiter '" + stack.peek() + "' remains";
        }
        System.out.println("End of input. Stack: " + stack.show());
        return "Valid";
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a sequence of characters: ");
        String input = sc.hasNextLine() ? sc.nextLine() : "";
        System.out.println("Input: " + input);
        System.out.println();
        System.out.println("Result: " + check(input));
        sc.close();
    }
}
